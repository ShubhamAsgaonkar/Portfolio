# ─── Node.js / npm ───────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
package-lock.json   # keep if you want reproducible installs; remove this line to track it

# ─── Generated / build artefacts ─────────────────────────────────────────────
# Static blog pages are auto-generated by generate_blog_data.js
# Remove these lines if you want to commit the generated pages
Blogs/**/index.html
blog_data.js

# ─── Sensitive / personal files ──────────────────────────────────────────────
*.env
.env
.env.*
secrets.*

# ─── Resume PDFs (large binary; track manually if desired) ───────────────────
# Comment out if you DO want the PDF in the repo
# *.pdf

# ─── OS artefacts ────────────────────────────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ─── Editor / IDE ────────────────────────────────────────────────────────────
# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# ─── Logs & temp files ───────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
